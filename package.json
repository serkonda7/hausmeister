{
  "name": "hausmeister",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "bun run .output/server/index.mjs",
    "healthcheck": "bun run scripts/healthcheck.ts",
    "create-admin-invite": "bun run scripts/create-admin-invite.ts",
    "gen": "bun run i18n && bun run scripts/gen.ts",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --silent",
    "lint": "biome check --write",
    "lint:ci": "biome ci",
    "typecheck": "bun run gen && tsc --noEmit",
    "check": "bun run lint:ci && bun run typecheck",
    "db:generate": "bun --bun drizzle-kit generate",
    "restore-test": "bash deploy/restore-test.sh",
    "check-tailnet": "bash deploy/check-tailnet.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.261103-rc",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-solid": "2.11.16"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@kobalte/core": "0.13.14",
    "@tanstack/solid-form": "1.33.5",
    "@tanstack/solid-query": "5.108.0",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-start": "1.169.5",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "drizzle-orm": "0.45.4",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "solid-js": "1.9.19",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  }
}
