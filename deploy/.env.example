# Copy to .env (chmod 600). Back this file up in your password manager.
# The node's MagicDNS name: hausmeister.<tailnet DNS name>.ts.net (see ./check-tailnet.sh).
DOMAIN=hausmeister.tail1234.ts.net
# Only for the first `up`; delete afterwards (state lives in ./ts-state)
TS_AUTHKEY=
APP_VERSION=dev
# Signs sessions and device cookies (passed to the app as BETTER_AUTH_SECRET).
# At least 32 characters. Generate once: openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=
# ISBN auto-fill asks the Deutsche Nationalbibliothek and Open Library (outbound
# HTTPS from the server, only the ISBN is sent). Set to "off" to keep it local.
ISBN_LOOKUP=on
