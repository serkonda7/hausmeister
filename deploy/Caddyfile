# DOMAIN is the node's MagicDNS name (hausmeister.<tailnet>.ts.net). The
# certificate comes from the Tailscale sidecar, which gets it from Let's Encrypt
# and renews it; Caddy asks over the shared tailscaled socket (compose.yaml).
{$DOMAIN} {
	tls {
		get_certificate tailscale
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:3000
}
