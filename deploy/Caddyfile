{
	# Staging by default. After the staging cert works, set in .env:
	#   ACME_CA=https://acme-v02.api.letsencrypt.org/directory
	acme_ca {$ACME_CA}
}

{$DOMAIN} {
	tls {
		# The domain is hosted at deSEC; the token may only write _acme-challenge TXT.
		dns desec {
			token {env.DESEC_TOKEN}
		}
		# Public resolvers; the VPS's own resolver may cache stale answers.
		resolvers 1.1.1.1 9.9.9.9
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy app:3000
}
