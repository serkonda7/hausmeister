# Copy to .env.backup (chmod 600). Back this file up in your password manager.
# Backblaze B2 via its S3-compatible API. The endpoint is shown on the bucket's
# page ("Endpoint: s3.<region>.backblazeb2.com"); the region is the part in the middle.
# Credentials: an Application Key restricted to this one bucket
# (keyID -> S3_ACCESS_KEY_ID, applicationKey -> S3_SECRET_ACCESS_KEY).
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=example-backup
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# restic (uploads). Same bucket under restic/, same B2 key as above.
RESTIC_REPOSITORY=s3:${S3_ENDPOINT}/${S3_BUCKET}/restic
RESTIC_PASSWORD=
# restic only reads the standard AWS names. Docker Compose resolves these
# references when it loads the file; plain `docker run --env-file` would not.
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=${S3_REGION}
